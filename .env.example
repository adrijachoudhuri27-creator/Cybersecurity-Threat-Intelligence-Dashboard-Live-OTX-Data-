# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="AIzaSyAW9MzvsHNd5ysaTwkkTayVOdbGYt3oZ_U"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://ai.studio/apps/89c637af-d6e2-4e37-b12f-547392e06b3d"

# OTX_API_KEY: AlienVault OTX REST API key (public search returned HTTP 403 without a key).
# CISA KEV and Abuse.ch Feodo feeds work without an API key.
OTX_API_KEY="d92e1779587c6d9065e78babb8e920bb3b0da82bd6bad7b1ede5bf174f1e2233"

# READ_ONLY_DEMO: Set to "true" on public demos to disable mutating POST/PATCH endpoints.
READ_ONLY_DEMO="false"

# ADMIN_TOKEN: Optional bearer token required for mutating endpoints (sync, ingest, triage).
ADMIN_TOKEN="Adrija@2706"
